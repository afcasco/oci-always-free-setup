version: 1

metadata:
  name: Homelab Users

entries:
  - model: authentik_core.group
    id: homelab-admins
    state: present
    identifiers:
      name: Homelab Admins
    attrs:
      name: Homelab Admins
      is_superuser: true

  - model: authentik_core.user
    id: primary-user
    state: present
    identifiers:
      username: "{{ authentik_primary_user }}"
    attrs:
      name: "{{ authentik_primary_user_name }}"
      email: "{{ authentik_primary_user_email }}"
      password: "{{ authentik_primary_user_password }}"
      is_active: true
      type: internal
      path: users
      groups:
        - !KeyOf homelab-admins

  - model: authentik_core.user
    id: bootstrap-admin
    state: present
    identifiers:
      username: akadmin
    attrs:
      email: ""
version: 1

metadata:
  name: Grafana OIDC

entries:
  - model: authentik_providers_oauth2.oauth2provider
    id: grafana-provider
    state: present
    identifiers:
      name: Grafana
    attrs:
      name: Grafana
      client_type: confidential
      client_id: "{{ grafana_oidc_client_id }}"
      client_secret: "{{ grafana_oidc_client_secret }}"

      grant_types:
        - authorization_code

      authorization_flow: !Find
        - authentik_flows.flow
        - [slug, default-provider-authorization-implicit-consent]

      invalidation_flow: !Find
        - authentik_flows.flow
        - [slug, default-provider-invalidation-flow]

      redirect_uris:
        - url: "{{ grafana_url }}/login/generic_oauth"
          matching_mode: strict
          redirect_uri_type: authorization

      property_mappings:
        - !Find
          - authentik_providers_oauth2.scopemapping
          - [scope_name, openid]
        - !Find
          - authentik_providers_oauth2.scopemapping
          - [scope_name, email]
        - !Find
          - authentik_providers_oauth2.scopemapping
          - [scope_name, profile]

  - model: authentik_core.application
    id: grafana-application
    state: present
    identifiers:
      slug: grafana
    attrs:
      name: Grafana
      slug: grafana
      provider: !KeyOf grafana-provider
      meta_launch_url: "{{ grafana_url }}"

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !KeyOf grafana-application
      order: 10
    attrs:
      group: !Find
        - authentik_core.group
        - [ name, Homelab Admins ]

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !KeyOf grafana-application
      order: 20
    attrs:
      group: !Find
        - authentik_core.group
        - [ name, grafana-users ]
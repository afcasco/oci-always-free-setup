{
    metrics {
        per_host
    }
}

:9180 {
    metrics /metrics
}

{{ homelab_domain }} {
    reverse_proxy apache:80
}

www.{{ homelab_domain }} {
    redir https://{{ homelab_domain }}{uri} permanent
}

{% if 'n8n' in enabled_stacks %}
    n8n.{{ homelab_domain }} {
    reverse_proxy n8n:5678
    }
{% endif %}

portainer.{{ homelab_domain }} {
    reverse_proxy portainer:9000
}

status.{{ homelab_domain }} {
    route {
        reverse_proxy /outpost.goauthentik.io/* authentik-server:9000

        forward_auth authentik-server:9000 {
        uri /outpost.goauthentik.io/auth/caddy

        copy_headers {
            X-Authentik-Username
            X-Authentik-Groups
            X-Authentik-Entitlements
            X-Authentik-Email
            X-Authentik-Name
            X-Authentik-Uid
            X-Authentik-Jwt
            X-Authentik-Meta-Jwks
            X-Authentik-Meta-Outpost
            X-Authentik-Meta-Provider
            X-Authentik-Meta-App
            X-Authentik-Meta-Version
        }
    }

    reverse_proxy uptime-kuma:3001
    }
}

paperless.{{ homelab_domain }} {
    reverse_proxy paperless:8000
}

pdf.{{ homelab_domain }} {
    reverse_proxy stirling-pdf:8080
}

airflow.{{ homelab_domain }} {
    reverse_proxy airflow-api-server:8080
}

grafana.{{ homelab_domain }} {
    reverse_proxy grafana:3000
}

auth.{{ homelab_domain }} {
    reverse_proxy authentik-server:9000
}
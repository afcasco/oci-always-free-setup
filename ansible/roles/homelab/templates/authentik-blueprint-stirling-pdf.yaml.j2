# Stirling PDF OIDC configuration
version: 1

metadata:
  name: Stirling PDF OIDC

entries:
  - model: authentik_providers_oauth2.oauth2provider
    id: stirling-pdf-provider
    state: present
    identifiers:
      name: Stirling PDF
    attrs:
      name: Stirling PDF

      client_type: confidential
      client_id: "{{ stirling_oidc_client_id }}"
      client_secret: "{{ stirling_oidc_client_secret }}"

      signing_key: !Find
        - authentik_crypto.certificatekeypair
        - [ name, authentik Self-signed Certificate ]

      grant_types:
        - authorization_code

      authorization_flow: !Find
        - authentik_flows.flow
        - [slug, default-provider-authorization-implicit-consent]

      invalidation_flow: !Find
        - authentik_flows.flow
        - [slug, default-provider-invalidation-flow]

      redirect_uris:
        - url: "{{ stirling_pdf_url }}/login/oauth2/code/authentik"
          matching_mode: strict
          redirect_uri_type: authorization

      property_mappings:
        - !Find
          - authentik_providers_oauth2.scopemapping
          - [scope_name, openid]
        - !Find
          - authentik_providers_oauth2.scopemapping
          - [scope_name, email]
        - !Find
          - authentik_providers_oauth2.scopemapping
          - [scope_name, profile]

  - model: authentik_core.application
    id: stirling-pdf-application
    state: present
    identifiers:
      slug: stirling-pdf
    attrs:
      name: Stirling PDF
      slug: stirling-pdf
      provider: !KeyOf stirling-pdf-provider
      meta_launch_url: "{{ stirling_pdf_url }}"

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !KeyOf stirling-pdf-application
      order: 10
    attrs:
      group: !Find
        - authentik_core.group
        - [name, Homelab Admins]

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !KeyOf stirling-pdf-application
      order: 20
    attrs:
      group: !Find
        - authentik_core.group
        - [name, stirling-pdf-users]
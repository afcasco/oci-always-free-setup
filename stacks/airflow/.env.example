# Copy to .env and replace every CHANGE_ME value.
# Build stacks/airflow/Dockerfile and use its tag here.
AIRFLOW_IMAGE_NAME=homelab-airflow:latest
POSTGRES_USER=airflow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=airflow
AIRFLOW_FERNET_KEY=CHANGE_ME_GENERATE_A_FERNET_KEY
AIRFLOW_API_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET

version: 1

metadata:
  name: Portainer OIDC

entries:
  - model: authentik_providers_oauth2.oauth2provider
    id: portainer-provider
    state: present
    identifiers:
      name: Portainer
    attrs:
      name: Portainer
      client_type: confidential
      client_id: "{{ portainer_oidc_client_id }}"
      client_secret: "{{ portainer_oidc_client_secret }}"

      grant_types:
        - authorization_code

      authorization_flow: !Find
        - authentik_flows.flow
        - [slug, default-provider-authorization-implicit-consent]

      invalidation_flow: !Find
        - authentik_flows.flow
        - [slug, default-provider-invalidation-flow]

      redirect_uris:
        - url: "{{ portainer_url }}/"
          matching_mode: strict
          redirect_uri_type: authorization

      property_mappings:
        - !Find
          - authentik_providers_oauth2.scopemapping
          - [scope_name, openid]
        - !Find
          - authentik_providers_oauth2.scopemapping
          - [scope_name, email]
        - !Find
          - authentik_providers_oauth2.scopemapping
          - [scope_name, profile]

  - model: authentik_core.application
    id: portainer-application
    state: present
    identifiers:
      slug: portainer
    attrs:
      name: Portainer
      slug: portainer
      provider: !KeyOf portainer-provider
      meta_launch_url: "{{ portainer_url }}"

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !KeyOf portainer-application
      order: 10
    attrs:
      group: !Find
        - authentik_core.group
        - [name, Homelab Admins]

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !KeyOf portainer-application
      order: 20
    attrs:
      group: !Find
        - authentik_core.group
        - [name, portainer-users]
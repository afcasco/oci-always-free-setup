version: 1

metadata:
  name: Uptime Kuma Proxy

entries:
  - model: authentik_providers_proxy.proxyprovider
    id: uptime-kuma-provider
    state: present
    identifiers:
      name: Uptime Kuma
    attrs:
      name: Uptime Kuma

      authorization_flow: !Find
        - authentik_flows.flow
        - [slug, default-provider-authorization-implicit-consent]

      invalidation_flow: !Find
        - authentik_flows.flow
        - [slug, default-provider-invalidation-flow]

      mode: forward_single
      external_host: "https://status.{{ homelab_domain }}"

  - model: authentik_core.application
    id: uptime-kuma-application
    state: present
    identifiers:
      slug: uptime-kuma
    attrs:
      name: Uptime Kuma
      slug: uptime-kuma
      provider: !KeyOf uptime-kuma-provider
      meta_launch_url: "https://status.{{ homelab_domain }}"

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !KeyOf uptime-kuma-application
      order: 10
    attrs:
      group: !Find
        - authentik_core.group
        - [ name, Homelab Admins ]

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !KeyOf uptime-kuma-application
      order: 20
    attrs:
      group: !Find
        - authentik_core.group
        - [ name, uptime-kuma-users ]

  - model: authentik_outposts.outpost
    state: present
    identifiers:
      managed: goauthentik.io/outposts/embedded
    attrs:
      providers:
        - !KeyOf uptime-kuma-provider
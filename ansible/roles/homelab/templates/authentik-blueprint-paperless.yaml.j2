version: 1

metadata:
  name: Paperless OIDC

entries:
  - model: authentik_providers_oauth2.oauth2provider
    id: paperless-provider
    state: present
    identifiers:
      name: Paperless
    attrs:
      name: Paperless

      client_type: confidential
      client_id: "{{ paperless_oidc_client_id }}"
      client_secret: "{{ paperless_oidc_client_secret }}"

      signing_key: !Find
        - authentik_crypto.certificatekeypair
        - [name, authentik Self-signed Certificate]

      grant_types:
        - authorization_code

      authorization_flow: !Find
        - authentik_flows.flow
        - [slug, default-provider-authorization-implicit-consent]

      invalidation_flow: !Find
        - authentik_flows.flow
        - [slug, default-provider-invalidation-flow]

      redirect_uris:
        - url: "{{ paperless_url }}/accounts/oidc/authentik/login/callback/"
          matching_mode: strict
          redirect_uri_type: authorization

      property_mappings:
        - !Find
          - authentik_providers_oauth2.scopemapping
          - [scope_name, openid]
        - !Find
          - authentik_providers_oauth2.scopemapping
          - [scope_name, email]
        - !Find
          - authentik_providers_oauth2.scopemapping
          - [scope_name, profile]

  - model: authentik_core.application
    id: paperless-application
    state: present
    identifiers:
      slug: paperless
    attrs:
      name: Paperless
      slug: paperless
      provider: !KeyOf paperless-provider
      meta_launch_url: "{{ paperless_url }}"

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !KeyOf paperless-application
      order: 10
    attrs:
      group: !Find
        - authentik_core.group
        - [name, Homelab Admins]

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !KeyOf paperless-application
      order: 20
    attrs:
      group: !Find
        - authentik_core.group
        - [name, paperless-users]